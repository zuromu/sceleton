{
  "manifest_version": 3,
  "name": "Sceleton",
  "short_name": "Sceleton",
  "version": "0.2.0",
  "description": "A better way to use SCeLE: deadlines on your toolbar, reminders, new material alerts, one-click downloads and search.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Sceleton",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "notifications", "downloads", "offscreen", "clipboardWrite"],
  "host_permissions": ["https://scele.cs.ui.ac.id/*"],
  "content_scripts": [
    {
      "matches": ["https://scele.cs.ui.ac.id/*"],
      "js": ["content/scele.js"],
      "css": ["content/scele.css"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Open the Sceleton popup"
    },
    "open-dashboard": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Open the Sceleton dashboard"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": ["https://scele.cs.ui.ac.id/*"]
    }
  ]
}
